[Unit]
Description=DNS API over knotc (doesnmlab.xyz)
After=knot.service
Requires=knot.service

[Service]
Type=simple
User=root
ExecStart=/usr/bin/python3 /opt/dnsapi/dnsapi.py
Restart=always
RestartSec=5
NoNewPrivileges=no
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
ReadWritePaths=/run/knot /etc/dnsapi
# The service shells out to knotc, which needs the control socket and the config.
ReadOnlyPaths=/etc/knot

[Install]
WantedBy=multi-user.target
