#!/bin/sh
# Rebuild and restart the twtxt bridge from the upstream tarball.
# Deliberately no git: this box has none, and installing packages there has
# broken dependency chains before.
set -eu

src=/opt/twtxt-bridge
tmp="${src}.new"

# The volume holds the actor signing key; creating it is idempotent.
docker volume create twtxt-bridge-data >/dev/null

rm -rf "$tmp"
mkdir -p "$tmp"
curl -fsSL https://github.com/anotherdoesnm/twtxt-bridge/archive/refs/heads/main.tar.gz \
  | tar -xz -C "$tmp" --strip-components=1

rm -rf "${src}.old"
if [ -d "$src" ]; then mv "$src" "${src}.old"; fi
mv "$tmp" "$src"

exec docker compose -f /root/twtxt-bridge/compose.yml up -d --build
