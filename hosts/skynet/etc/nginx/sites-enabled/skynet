server {
    listen 8443 ssl;
    server_name skynet.doesnmlab.xyz;
    # nginx defaults to 1 MB, which turned every file upload over a megabyte into a 413.
    client_max_body_size 100m;
    absolute_redirect off;

    ssl_certificate     /etc/nginx/selfsigned.crt;
    ssl_certificate_key /etc/nginx/selfsigned.key;

    location = / {
        include /etc/nginx/dsh_token.inc;
        if ($dsh_redirect = 1) {
            return 302 /?token=$dsh_launch_token;
        }
        include /etc/nginx/snippets/dsh_proxy.conf;
    }

    location / {
        include /etc/nginx/snippets/dsh_proxy.conf;
    }
}
