[Unit]
Description=SokobotNET (Sokoban bot for the Fluxer instance)
After=network-online.target

[Service]
Type=simple
WorkingDirectory=/opt/sokobot
EnvironmentFile=/opt/sokobot/.env
ExecStart=/opt/sokobot/run.sh
Restart=on-failure
RestartSec=5
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes

[Install]
WantedBy=multi-user.target
